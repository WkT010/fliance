# Fliance（梵响） Configuration
# Environment: copy to .env and customize
#
# !!! 安全要求 !!!
# - .env 文件严禁提交到版本库（已在 .gitignore 中排除），真实密钥只保存在部署环境。
# - JWT_SECRET：至少 32 字节随机值，如 openssl rand -base64 48。
# - 数据库/Redis 密码：16+ 位，含大小写字母、数字、特殊字符；禁止使用弱默认值。
# - 密钥一旦泄露（含 Git 历史）必须立即轮换。

# ── Security ────────────────────────────────────────────────────────────
# 启动必填：生产环境必须替换为强随机值（openssl rand -base64 48）
JWT_SECRET=CHANGE_ME-strong-random-32-bytes-min
JWT_ISSUER=fliance-exchange

# 启动必填（生产）：matching-engine 在 ENVIRONMENT != development 时缺省会 fatal。
# api-gateway 与 matching-engine 必须使用同一值；生成：openssl rand -base64 32
GRPC_SHARED_TOKEN=CHANGE_ME-openssl-rand-base64-32

# ── Server ──────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080
GRPC_ADDR=:50051
ENVIRONMENT=development

# ── Domain (required for production SSL) ────────────────────────────────
# 启动必填（生产）：docker-compose.prod.yml 会用 DOMAIN 拼装 CORS 白名单，
# 未设置时拒绝启动。填真实对外域名（不含 scheme）。
DOMAIN=your-domain.com

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DSN=postgres://nexa:CHANGE_ME@localhost:5432/nexa?sslmode=disable
POSTGRES_PASSWORD=CHANGE_ME-strong-password-16chars

# ── Supabase（可选托管 PostgreSQL）────────────────────────────────────────
# 使用 Supabase 托管数据库时，将上面的 POSTGRES_DSN 替换为 Supabase 连接串：
#   端口 6543 = Transaction pooler（PgBouncer 事务池，推荐，本项目的
#             lib/pq 用法与其兼容：无 LISTEN/NOTIFY、无会话级状态）；
#   端口 5432 = Direct connection（直连 Postgres，会话特性完整，
#             需要 LISTEN/NOTIFY 或会话级锁时使用）。
# Supabase 强制 TLS，务必保留 sslmode=require。
# 用户名格式为 postgres.<project-ref>，密码为 Supabase 项目数据库密码。
#POSTGRES_DSN=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ── Cache ───────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
# 生产环境必填（docker-compose.prod.yml 强制开启 requirepass）
REDIS_PASSWORD=
REDIS_DB=0

# ── Streaming ────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=fliance-exchange

# ── Trading ──────────────────────────────────────────────────────────────
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,ADA/USDT

# ── Matching Engine Persistence ──────────────────────────────────────────
# WAL_DIR and SNAPSHOT_DIR must be on durable, fast storage in production.
WAL_DIR=./data/wal
SNAPSHOT_DIR=./data/snapshots
SNAPSHOT_INTERVAL=60s

# ── WAL Sync Tuning (optional) ────────────────────────────────────────
# 可选调优：WAL_SYNC_EVERY = 每 N 条记录 fsync（默认 1，每条都 sync）；
# WAL_SYNC_INTERVAL_MS = 两次 fsync 的最大间隔毫秒数。二者均缺省时使用安全默认。
WAL_SYNC_EVERY=1
WAL_SYNC_INTERVAL_MS=10

# ── Blockchain ──────────────────────────────────────────────────────────
# Sign up at https://www.alchemy.com/ to get an API key（视为密钥管理，勿提交真实值）
ALCHEMY_API_KEY=

# ── TLS / SSL ───────────────────────────────────────────────────────────
# Option A: Certificate files
TLS_CERT_FILE=
TLS_KEY_FILE=
# Option B: Auto cert (Let's Encrypt) — requires DOMAIN and port 443
TLS_AUTO_CERT=false

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_PER_SEC=100
RATE_LIMIT_BURST=200
ENABLE_REDIS_RATE_LIMIT=false

# ── CORS ────────────────────────────────────────────────────────────────
# 启动必填（生产）：逗号分隔的显式白名单（含 scheme）。
# ⚠ 非 development 环境禁止使用 *（含缺省回退到 *），否则 api-gateway 启动失败。
CORS_ALLOW_ORIGINS=https://your-domain.com
CORS_ALLOW_CREDENTIALS=false

# ── Account Security ────────────────────────────────────────────────────
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MIN=15
ENABLE_API_KEY_AUTH=true

# ── HTTP / WebSocket Hardening (optional) ───────────────────────────────
# 可选调优：请求体上限（字节，默认 1MiB）、全局 WS 连接数上限、
# 单 IP 每分钟 WS 新建连接速率上限
MAX_REQUEST_BODY_BYTES=1048576
WS_MAX_CONNECTIONS=10000
WS_CONNECT_RATE_PER_MIN=30

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text