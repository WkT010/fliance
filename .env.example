# NEXA Exchange Configuration
# Environment: copy to .env and customize

# ── Security ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ISSUER=nexa-exchange

# ── Server ──────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080
GRPC_ADDR=:50051
ENVIRONMENT=development

# ── Domain (required for production SSL) ────────────────────────────────
# DOMAIN=exchange.nexa.com

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DSN=postgres://nexa:nexa_dev@localhost:5432/nexa?sslmode=disable
POSTGRES_PASSWORD=nexa_dev

# ── Cache ───────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Streaming ────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=nexa-exchange

# ── Trading ──────────────────────────────────────────────────────────────
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,ADA/USDT

# ── Blockchain ──────────────────────────────────────────────────────────
# Sign up at https://www.alchemy.com/ to get an API key
ALCHEMY_API_KEY=

# ── TLS / SSL ───────────────────────────────────────────────────────────
# Option A: Certificate files
TLS_CERT_FILE=
TLS_KEY_FILE=
# Option B: Auto cert (Let's Encrypt) — requires DOMAIN and port 443
TLS_AUTO_CERT=false

# ── Rate Limiting ──────────────────────────────────────────────────────
RATE_LIMIT_PER_SEC=100
RATE_LIMIT_BURST=200
ENABLE_REDIS_RATE_LIMIT=false

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated origins. "*" allows all (not recommended with credentials).
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# ── Account Security ────────────────────────────────────────────────────
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MIN=15
ENABLE_API_KEY_AUTH=true

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text